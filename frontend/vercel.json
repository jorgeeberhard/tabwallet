{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tabwallet.vercel.app" }],
      "destination": "https://tabwallet.com.br/:path*",
      "permanent": true
    }
  ]
}
