# Copy to `.env` for local development (`.env` is git-ignored).
DATABASE_URL=postgres://tabwallet:tabwallet@localhost:5432/tabwallet
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info

# Secret that signs session tokens (JWT, HS256). Required, at least 32
# characters. Generate a real one per environment, for example with
# `openssl rand -base64 48`, and never commit it. The value below is only a
# placeholder for local development.
JWT_SECRET=local-development-secret-change-me-0123456789

# Environment. `development` allows the log-only e-mail fallback below and a
# default APP_URL; anything else (the default) is treated as production, where
# both must be configured explicitly or the API refuses to start.
APP_ENV=development

# Public address of the front-end, used to build the password-reset link in
# e-mails (no trailing slash needed). Required unless APP_ENV=development.
APP_URL=http://localhost:3000

# E-mail provider for the password-reset e-mail. Leave EMAIL_PROVIDER unset in
# development and the link is only written to the API log (info level).
# `resend` posts to an HTTP API in the Resend format (Bearer key, JSON body
# with from/to/subject/text). Never commit the key.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=TabWallet <no-reply@your-domain>
# EMAIL_API_URL=https://api.resend.com/emails

# The session cookie is `Secure` (HTTPS only) unless this is `false`. Leave it
# unset in production. Browsers send non-Secure cookies over plain
# http://localhost, so local development sets it to false.
COOKIE_SECURE=false
